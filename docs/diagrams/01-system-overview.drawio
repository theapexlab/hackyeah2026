<mxfile host="app.diagrams.net"><diagram id="overview" name="System overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="band1" value="" style="rounded=1;html=1;fillColor=#f7f9fc;strokeColor=none;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1120" height="130" as="geometry"/></mxCell><mxCell id="band2" value="" style="rounded=1;html=1;fillColor=#f3f3f3;strokeColor=none;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="1120" height="140" as="geometry"/></mxCell><mxCell id="band3" value="" style="rounded=1;html=1;fillColor=#f2f6fb;strokeColor=none;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="1120" height="170" as="geometry"/></mxCell><mxCell id="title" value="Pomóc" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="200" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="The network that is already there. One protocol, one identity, two rule sets: peace and emergency." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="800" height="22" as="geometry"/></mxCell><mxCell id="lbl1" value="&lt;b&gt;1 &amp;nbsp;Governance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:11px&quot;&gt;keys, rules, backhaul&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="50" as="geometry"/></mxCell><mxCell id="lbl2" value="&lt;b&gt;2 &amp;nbsp;Backbone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:11px&quot;&gt;static caste: home routers&lt;br&gt;works while power is on&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="180" height="60" as="geometry"/></mxCell><mxCell id="lbl3" value="&lt;b&gt;3 &amp;nbsp;Edge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:11px&quot;&gt;mobile caste: phones&lt;br&gt;works while batteries last&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="180" height="60" as="geometry"/></mxCell><mxCell id="auth" value="" style="rounded=1;html=1;fillColor=#e3edf9;strokeColor=#9db5d6;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="95" width="280" height="100" as="geometry"/></mxCell><mxCell id="auth_i" value="" style="sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#3f6fb0;strokeColor=none;outlineConnect=0;shape=mxgraph.cisco.buildings.government_building;" vertex="1" parent="auth"><mxGeometry x="14" y="24" width="68" height="50" as="geometry"/></mxCell><mxCell id="auth_t" value="&lt;b&gt;Authority (state)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;issues citizen certificates&lt;br&gt;signs alerts and emergency declarations&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="auth"><mxGeometry x="92" y="10" width="182" height="80" as="geometry"/></mxCell><mxCell id="muni" value="" style="rounded=1;html=1;fillColor=#ece4f2;strokeColor=#b39ac6;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="95" width="280" height="100" as="geometry"/></mxCell><mxCell id="muni_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/dashboard-857.svg;" vertex="1" parent="muni"><mxGeometry x="20" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="muni_t" value="&lt;b&gt;Municipality dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;peace: coverage map, gaps to fix&lt;br&gt;emergency: check-ins, open requests&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="muni"><mxGeometry x="92" y="10" width="182" height="80" as="geometry"/></mxCell><mxCell id="isp" value="" style="rounded=1;html=1;fillColor=#fdf4d8;strokeColor=#d9bf6a;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="95" width="280" height="100" as="geometry"/></mxCell><mxCell id="isp_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Cloud-2703/connection-data-cloud-network-compute-server-658.svg;" vertex="1" parent="isp"><mxGeometry x="18" y="20" width="60" height="60" as="geometry"/></mxCell><mxCell id="isp_t" value="&lt;b&gt;ISP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;switches on the dormant relay on customers' routers, over the TR-369 channel it already uses&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="isp"><mxGeometry x="92" y="10" width="182" height="80" as="geometry"/></mxCell><mxCell id="gw" value="" style="rounded=1;html=1;fillColor=#e2f0df;strokeColor=#93bc8a;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="262" width="190" height="90" as="geometry"/></mxCell><mxCell id="gw_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Electronics_Outline_24-2589/satellite_dish_dish_antenna_parabolic_antenna_radar_space-689.svg;" vertex="1" parent="gw"><mxGeometry x="12" y="19" width="52" height="52" as="geometry"/></mxCell><mxCell id="gw_t" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;satellite or fibre, generator-backed, the mesh's door to the Authority&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="gw"><mxGeometry x="70" y="6" width="116" height="78" as="geometry"/></mxCell><mxCell id="r1" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="262" width="150" height="90" as="geometry"/></mxCell><mxCell id="r1_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Computer_Hardware_Line_vol_2-2898/wifi__wireless__internet__network__signal__connection__router-1489.svg;" vertex="1" parent="r1"><mxGeometry x="10" y="19" width="52" height="52" as="geometry"/></mxCell><mxCell id="r1_t" value="&lt;b&gt;Home router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;relay only&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="66" y="10" width="82" height="70" as="geometry"/></mxCell><mxCell id="r2" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="262" width="150" height="90" as="geometry"/></mxCell><mxCell id="r2_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Computer_Hardware_Line_vol_2-2898/wifi__wireless__internet__network__signal__connection__router-1489.svg;" vertex="1" parent="r2"><mxGeometry x="10" y="19" width="52" height="52" as="geometry"/></mxCell><mxCell id="r2_t" value="&lt;b&gt;Home router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;relay only&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="r2"><mxGeometry x="66" y="10" width="82" height="70" as="geometry"/></mxCell><mxCell id="r3" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="262" width="150" height="90" as="geometry"/></mxCell><mxCell id="r3_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Computer_Hardware_Line_vol_2-2898/wifi__wireless__internet__network__signal__connection__router-1489.svg;" vertex="1" parent="r3"><mxGeometry x="10" y="19" width="52" height="52" as="geometry"/></mxCell><mxCell id="r3_t" value="&lt;b&gt;Home router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;battery-backed&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="r3"><mxGeometry x="66" y="10" width="82" height="70" as="geometry"/></mxCell><mxCell id="r4" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="262" width="150" height="90" as="geometry"/></mxCell><mxCell id="r4_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Computer_Hardware_Line_vol_2-2898/wifi__wireless__internet__network__signal__connection__router-1489.svg;" vertex="1" parent="r4"><mxGeometry x="10" y="19" width="52" height="52" as="geometry"/></mxCell><mxCell id="r4_t" value="&lt;b&gt;Home router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;relay only&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="r4"><mxGeometry x="66" y="10" width="82" height="70" as="geometry"/></mxCell><mxCell id="note2" value="Routers see each other over Wi-Fi mesh. Static and dense in cities, so coverage can be planned in advance. In emergency mode they also open a captive portal for phones without the app." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="357" width="660" height="20" as="geometry"/></mxCell><mxCell id="c1" value="" style="rounded=1;html=1;fillColor=#e3edf9;strokeColor=#9db5d6;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="c1_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Electronics_Outline_24-2589/smartphone_cell_phone_cellular_phone_mobile_mobile_phone-691.svg;" vertex="1" parent="c1"><mxGeometry x="12" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="c1_t" value="&lt;b&gt;Citizen phone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;verified identity&lt;br&gt;asks, offers, relays&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="76" y="10" width="120" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;html=1;fillColor=#e3edf9;strokeColor=#9db5d6;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="c2_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Electronics_Outline_24-2589/smartphone_cell_phone_cellular_phone_mobile_mobile_phone-691.svg;" vertex="1" parent="c2"><mxGeometry x="12" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="c2_t" value="&lt;b&gt;Citizen phone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;verified identity&lt;br&gt;asks, offers, relays&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="c2"><mxGeometry x="76" y="10" width="120" height="80" as="geometry"/></mxCell><mxCell id="u1" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#9a9a9a;strokeWidth=1.5;dashed=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="u1_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Electronics_Outline_24-2589/smartphone_cell_phone_cellular_phone_mobile_mobile_phone-691.svg;opacity=40;" vertex="1" parent="u1"><mxGeometry x="12" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="u1_t" value="&lt;b&gt;&lt;font color=&quot;#666666&quot;&gt;Unregistered phone&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;no identity&lt;br&gt;relays only, in emergency mode&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="u1"><mxGeometry x="76" y="10" width="120" height="80" as="geometry"/></mxCell><mxCell id="aed" value="" style="rounded=1;html=1;fillColor=#fbe3e1;strokeColor=#d19a96;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="432" width="210" height="100" as="geometry"/></mxCell><mxCell id="aed_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Clinical-2489/first-aid-1249.svg;" vertex="1" parent="aed"><mxGeometry x="12" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="aed_t" value="&lt;b&gt;Public AED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;registered resource: defibrillator, shelter, water point. Signed, pinned to a place&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="aed"><mxGeometry x="76" y="8" width="130" height="84" as="geometry"/></mxCell><mxCell id="note3" value="Phones see each other over Bluetooth LE and Wi-Fi. When the grid fails this layer keeps going for hours; people walking carry messages between islands." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="230" y="540" width="900" height="20" as="geometry"/></mxCell><mxCell id="certkey" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/material-symbols/1/Security_Key.svg;" vertex="1" parent="1"><mxGeometry x="232" y="385" width="26" height="26" as="geometry"/></mxCell><mxCell id="certlbl" value="citizen certificate, issued once in peace mode through the identity wallet (mObywatel / EUDI)" style="text;html=1;fontSize=10;fontColor=#3f6fb0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="388" width="560" height="20" as="geometry"/></mxCell><mxCell id="e_cert" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3f6fb0;strokeWidth=2;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.07;entryY=0;entryDx=0;entryDy=0;endArrow=classic;" edge="1" parent="1" source="auth" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_bh" value="backhaul" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#555555;strokeColor=#555555;strokeWidth=2;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=classic;endArrow=classic;labelBackgroundColor=#f3f3f3;" edge="1" parent="1" source="auth" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dash" value="topology, check-ins, delivery stats" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#7a5a99;strokeColor=#9673a6;strokeWidth=2;endArrow=classic;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="auth" target="muni"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_isp" value="relay firmware + relay certificate" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#8a6d1f;strokeColor=#c9a227;strokeWidth=2;exitX=0.73;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;labelBackgroundColor=#f3f3f3;" edge="1" parent="1" source="isp" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_gw_r1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1" source="gw" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r12" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r23" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r34" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r1c2" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.425;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r2u1" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.125;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r4aed" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.64;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="aed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_c12" style="endArrow=none;dashed=1;html=1;strokeColor=#3f6fb0;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_c2u" style="endArrow=none;dashed=1;html=1;strokeColor=#3f6fb0;strokeWidth=2;" edge="1" parent="1" source="c2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Reading the picture:&lt;/b&gt; dashed line = radio neighbours, an edge of the proximity graph &amp;nbsp;·&amp;nbsp; solid arrow = administrative or backhaul relationship &amp;nbsp;·&amp;nbsp; blue = verified citizen &amp;nbsp;·&amp;nbsp; dashed box = no identity, relay only. &lt;b&gt;Only citizens can ask; routers and gateways only carry.&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="1120" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
