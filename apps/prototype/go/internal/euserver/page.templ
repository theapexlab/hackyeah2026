package euserver

import "fmt"

templ Page(msgs []Received) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Pomóc server</title>
		</head>
		<body>
			<h1>Received messages</h1>
			if len(msgs) == 0 {
				<p>Nothing received yet.</p>
			} else {
				<table>
					<thead>
						<tr><th>Message id</th><th>Class</th><th>Signer</th><th>Seq</th><th>Payload</th><th>Received</th></tr>
					</thead>
					<tbody>
						for _, m := range msgs {
							<tr>
								<td>{ m.ID }</td>
								<td>{ m.Class }</td>
								<td>{ m.Signer }</td>
								<td>{ fmt.Sprint(m.Seq) }</td>
								<td>{ m.Payload }</td>
								<td>{ m.At.Format("15:04:05") }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</body>
	</html>
}
